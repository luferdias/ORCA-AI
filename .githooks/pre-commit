#!/bin/sh
# Hook de pre-commit do ORCA-AI.
# 1) Varredura de segredos em todos os arquivos de texto preparados.
# 2) ruff check e ruff format --check nos arquivos Python preparados.
#
# Ativar uma vez por clone:
#   git config core.hooksPath .githooks
# Pular em um commit específico:
#   git commit --no-verify

set -e

raiz=$(git rev-parse --show-toplevel)
cd "$raiz"

# ---------------------------------------------------------------- segredos
todos=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$todos" ]; then
    IFS='
'
    set -- $todos
    unset IFS
    aspas="\"'\`"
    padrao="(senha|password|passwd|api[_-]?key|secret[_-]?key|access[_-]?token|private[_-]?key)[[:space:]]*[:=][[:space:]]*[$aspas]?[^[:space:]$aspas<\$]{6,}"
    # Exclui marcadores, exemplos e leituras de ambiente.
    achados=$(grep -nIiE "$padrao" "$@" 2>/dev/null \
        | grep -viE 'REMOVID|EXEMPLO|EXAMPLE|PLACEHOLDER|YOUR_|\$\{|os\.environ|getenv|process\.env|keyring|\.githooks/pre-commit|docs/historico/|\.github/workflows/ci\.yml' || true)
    if [ -n "$achados" ]; then
        echo "pre-commit: possível segredo em arquivo preparado:" >&2
        echo "$achados" | cut -c1-160 >&2
        echo >&2
        echo "pre-commit: remova a credencial. Regra do projeto: o engenheiro faz o login" >&2
        echo "            manualmente; nenhuma senha ou chave fica no repositório." >&2
        exit 1
    fi
fi

# ------------------------------------------------------------------ python
arquivos=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$arquivos" ] && exit 0

if [ -x ".venv/bin/ruff" ]; then
    ruff=".venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    ruff="ruff"
elif command -v uvx >/dev/null 2>&1; then
    ruff="uvx ruff@0.17.3"
else
    echo "pre-commit: ruff não encontrado. Instale com:" >&2
    echo "  .venv/bin/pip install -r OrcaAI/ufg/ml/requirements-dev.txt" >&2
    exit 1
fi

IFS='
'
set -- $arquivos
unset IFS

status=0
echo "pre-commit: ruff check ($# arquivo(s) Python)"
$ruff check --force-exclude "$@" || status=1
echo "pre-commit: ruff format --check"
$ruff format --check --force-exclude "$@" || status=1

if [ $status -ne 0 ]; then
    echo >&2
    echo "pre-commit: corrija com 'ruff check --fix' e 'ruff format' nos arquivos acima," >&2
    echo "            adicione as mudanças ao stage e tente commitar novamente." >&2
    exit 1
fi
