#!/bin/sh
# Hook de pre-commit do ORCA-AI: roda ruff check e ruff format --check
# nos arquivos Python preparados para commit.
#
# Ativar uma vez por clone:
#   git config core.hooksPath .githooks
# Pular em um commit específico:
#   git commit --no-verify

set -e

raiz=$(git rev-parse --show-toplevel)
cd "$raiz"

arquivos=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -z "$arquivos" ] && exit 0

if [ -x "OrcaAI/ml/.venv/bin/ruff" ]; then
    ruff="OrcaAI/ml/.venv/bin/ruff"
elif command -v ruff >/dev/null 2>&1; then
    ruff="ruff"
elif command -v uvx >/dev/null 2>&1; then
    ruff="uvx ruff@0.17.3"
else
    echo "pre-commit: ruff não encontrado. Instale com:" >&2
    echo "  OrcaAI/ml/.venv/bin/pip install -r OrcaAI/ml/requirements-dev.txt" >&2
    exit 1
fi

# IFS por linha para suportar caminhos com espaços.
IFS='
'
set -- $arquivos
unset IFS

status=0
echo "pre-commit: ruff check ($# arquivo(s) Python)"
$ruff check "$@" || status=1
echo "pre-commit: ruff format --check"
$ruff format --check "$@" || status=1

if [ $status -ne 0 ]; then
    echo >&2
    echo "pre-commit: corrija com 'ruff check --fix' e 'ruff format' nos arquivos acima," >&2
    echo "            adicione as mudanças ao stage e tente commitar novamente." >&2
    exit 1
fi
