# Conteúdo do projeto, arquivos históricos e resultados são versionados.
# Apenas ambientes, caches e arquivos do sistema permanecem locais.
.DS_Store
.venv/
.temp_ag_kit/
.sixth/
__pycache__/
*.pyc
.pytest_cache/

.env
.env.*
!.env.example

# Dependências instaladas, logs e backups de CAD não são versionados.
node_modules/
*.log

# Execuções de ML ficam locais (OneDrive); só os manifestos são versionados.
OrcaAI/ufg/ml/outputs/*
!OrcaAI/ufg/ml/outputs/MANIFESTO.json
!OrcaAI/ufg/ml/outputs/MANIFESTO_arquivos.tsv

# Índices locais das bases: só o manifesto é versionado.
OrcaAI/knowledge/indices/**/servicos.csv

# Renderizações locais e histórico do R sobre os arquivos de memória não são versionados.
.Rhistory
memory/**/*.html

# Estado local do Maestri (papéis, canvas) não é versionado; os papéis estão descritos na spec do layout.
.maestri/

# Artefatos do Windows/OneDrive (nunca versionar)
desktop.ini
Thumbs.db

# Restos da migração do .git para ~/.gitdirs (D-095): o OneDrive pode ressuscitar pedaços; nunca commitar
.git.migrado*/
